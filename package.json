{
  "name": "litemetrics",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/dashboard",
    "apps/demo",
    "apps/landing",
    "apps/server"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=20",
    "test": "turbo test",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "release": "bun scripts/release.ts"
  },
  "packageManager": "bun@1.2.1",
  "devDependencies": {
    "@litemetrics/tracker": "workspace:*",
    "jsdom": "^29.1.1",
    "turbo": "^2",
    "typescript": "^5.7",
    "vitest": "^4.0.18"
  }
}
