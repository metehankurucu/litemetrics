{
  "name": "@litemetrics/cli",
  "version": "0.4.0",
  "description": "CLI tool for Litemetrics analytics - query data, manage sites, AI-agent friendly",
  "license": "MIT",
  "type": "module",
  "bin": {
    "litemetrics": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
