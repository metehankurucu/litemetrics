  },
  "dependencies": {
    "@litemetrics/client": "^0.4.0",
    "@litemetrics/core": "^0.6.0",
    "commander": "^12"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5.7"
  }
